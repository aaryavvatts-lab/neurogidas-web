---
import { MEETINGS, splitMeetings, parts, TRACK_LABEL, meetingEnd, roomOf } from '../data/meetings';
import { SITE, LINKS } from '../data/site';

interface Props {
  heading?: string;
  id?: string;
}
const { heading = 'Next meeting', id = 'next' } = Astro.props;
const { next } = splitMeetings();

// Everything the client needs to swap in a later meeting after this build goes stale.
const payload = MEETINGS.map((m) => ({ ...m, end: meetingEnd(m).toISOString(), roomName: roomOf(m) }));
const p = next ? parts(next.date) : null;

function calHref(m: NonNullable<typeof next>) {
  const end = meetingEnd(m);
  const start = new Date(end.getTime() - 45 * 60 * 1000);
  const f = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
  const q = new URLSearchParams({
    action: 'TEMPLATE',
    text: `NeuroGIDAS: ${m.title}`,
    dates: `${f(start)}/${f(end)}`,
    details: `${m.summary}\n\nhttps://neurogidas-web.vercel.app/meetings/`,
    location: `${roomOf(m)}, Eastview High School`,
  });
  return `https://calendar.google.com/calendar/render?${q}`;
}
---

<section class="next" id={id} aria-labelledby={`${id}-h`} data-next>
  <h2 class="next__h" id={`${id}-h`}>{heading}</h2>

  <div class="next__body" data-has-next={next ? 'true' : 'false'}>
    <div class="date tnum" aria-hidden="true">
      <span class="date__mon" data-f="mon">{p?.mon}</span>
      <span class="date__day" data-f="day">{p?.day}</span>
    </div>

    <div class="main">
      <p class="meta">
        <span class="tag" data-track={next?.track} data-f="track">{next && TRACK_LABEL[next.track]}</span>
        <span class="tentative" data-f="tentative" hidden={!next || next.confirmed}>Date might change</span>
      </p>
      <h3 class="title h2" data-f="title">{next?.title}</h3>
      <p class="summary" data-f="summary">{next?.summary}</p>
      <p class="open" data-f="open" hidden={!next?.openToAll}>Open to every Eastview student, not just members.</p>
    </div>

    <div class="facts">
      <dl>
      <div>
        <dt>When</dt>
        <dd class="tnum"><span data-f="long">{next && `Wednesday, ${p?.monthLong} ${p?.day}`}</span><br />{SITE.time}</dd>
      </div>
      <div>
        <dt>Where</dt>
        <dd data-f="room">{next ? roomOf(next) : ''}</dd>
      </div>
      </dl>
      <div class="actions">
        <a class="link" data-f="cal" href={next ? calHref(next) : '#'} rel="noopener">
          <svg viewBox="0 0 20 20" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4.5" width="14" height="12.5" rx="2" /><path d="M3 8.5h14M7 2.5v4M13 2.5v4" /></svg>
          Add to Google Calendar
        </a>
      </div>
    </div>

    <div class="empty">
      <p class="h3">That’s it for this school year.</p>
      <p class="muted">Meetings start again in the fall. Join the <a href={LINKS.groupme} rel="noopener">GroupMe</a> to hear when.</p>
    </div>
  </div>

  <script is:inline type="application/json" data-meetings set:html={JSON.stringify(payload)} />
</section>

<style>
  .next {
    border-top: 2px solid var(--ink);
    padding-top: var(--s-4);
  }

  .next__h {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0;
    font-variation-settings: 'wdth' 100;
    color: var(--ink);
  }

  .next__h::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--salmon);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--salmon) 22%, transparent);
  }

  .next__body {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(14rem, 18rem);
    gap: var(--s-6) clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
    padding-top: var(--s-6);
    align-items: start;
  }

  .date {
    display: grid;
    justify-items: start;
    line-height: 0.9;
    min-width: 5.5rem;
  }

  .date__mon {
    font-size: var(--step-1);
    font-weight: 650;
    color: var(--ink-2);
  }

  .date__day {
    font-size: clamp(4rem, 3rem + 4vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    font-variation-settings: 'wdth' 125;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }

  .tentative {
    font-size: var(--step--1);
    color: var(--ink-2);
    font-style: italic;
  }

  .title {
    margin-top: var(--s-3);
    max-width: 20ch;
  }

  .summary {
    margin-top: var(--s-4);
    color: var(--ink-2);
    max-width: 52ch;
  }

  .open {
    margin-top: var(--s-4);
    font-weight: 600;
    color: var(--salmon-ink);
  }

  .facts dl {
    margin: 0;
    display: grid;
    gap: var(--s-4);
  }

  .facts {
    display: grid;
    gap: var(--s-4);
    padding-left: var(--s-5);
    border-left: 1px solid var(--rule);
  }

  .facts dt {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .facts dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }

  .actions {
    padding-top: var(--s-2);
  }

  .empty {
    display: none;
    grid-column: 1 / -1;
  }

  .empty .muted {
    margin-top: var(--s-2);
  }

  [data-has-next='false'] > :not(.empty) {
    display: none;
  }

  [data-has-next='false'] .empty {
    display: block;
  }

  @media (max-width: 900px) {
    .next__body {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .facts dl {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }

    .facts {
      grid-column: 1 / -1;
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--rule);
      padding-top: var(--s-5);
    }
  }

  @media (max-width: 520px) {
    .next__body {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }

    .date {
      grid-auto-flow: column;
      align-items: baseline;
      gap: 0.6rem;
      justify-content: start;
    }

    .date__day {
      font-size: 3.25rem;
    }
  }
</style>

<script>
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const LABEL: Record<string, string> = { neuro: 'Neuroscience', gidas: 'GIDAS research', joint: 'Both tracks' };

  type M = { date: string; track: string; title: string; summary: string; confirmed: boolean; openToAll?: boolean; end: string; roomName: string };

  function calUrl(m: M) {
    const end = new Date(m.end);
    const start = new Date(end.getTime() - 45 * 60 * 1000);
    const f = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const q = new URLSearchParams({
      action: 'TEMPLATE',
      text: `NeuroGIDAS: ${m.title}`,
      dates: `${f(start)}/${f(end)}`,
      details: `${m.summary}\n\nhttps://neurogidas-web.vercel.app/meetings/`,
      location: `${m.roomName}, Eastview High School`,
    });
    return `https://calendar.google.com/calendar/render?${q}`;
  }

  document.querySelectorAll<HTMLElement>('[data-next]').forEach((root) => {
    const raw = root.querySelector('[data-meetings]')?.textContent;
    if (!raw) return;
    const all: M[] = JSON.parse(raw);
    const now = Date.now();
    const next = all.find((m) => new Date(m.end).getTime() >= now);
    const body = root.querySelector<HTMLElement>('.next__body')!;
    if (!next) {
      body.dataset.hasNext = 'false';
      return;
    }
    body.dataset.hasNext = 'true';
    const [, mo, d] = next.date.split('-').map(Number);
    const set = (k: string, v: string) => {
      const el = root.querySelector<HTMLElement>(`[data-f="${k}"]`);
      if (el) el.textContent = v;
    };
    set('mon', MONTHS[mo - 1]);
    set('day', String(d));
    set('title', next.title);
    set('summary', next.summary);
    set('long', `Wednesday, ${LONG[mo - 1]} ${d}`);
    set('room', next.roomName);
    const track = root.querySelector<HTMLElement>('[data-f="track"]');
    if (track) {
      track.dataset.track = next.track;
      track.textContent = LABEL[next.track];
    }
    root.querySelector<HTMLElement>('[data-f="tentative"]')!.hidden = next.confirmed;
    root.querySelector<HTMLElement>('[data-f="open"]')!.hidden = !next.openToAll;
    root.querySelector<HTMLAnchorElement>('[data-f="cal"]')!.href = calUrl(next);
  });
</script>
