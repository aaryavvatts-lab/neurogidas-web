---
import Base from '../layouts/Base.astro';
import JoinBand from '../components/JoinBand.astro';
import { EVENTS } from '../data/meetings';
import { LINKS } from '../data/site';

const steps = [
  { name: 'Pick a question', tool: 'Cancer focus', what: 'Choose something about the disease you actually want to find out.' },
  { name: 'Find a dataset', tool: 'NCBI GEO', what: 'Pick a public study that measured genes and fits your question.' },
  { name: 'Find what changed', tool: 'GEO2R', what: 'Compare sick and healthy samples to see which genes go up or down.' },
  { name: 'Map the proteins', tool: 'STRING', what: 'See how the proteins from those genes connect to each other.' },
  { name: 'Find pathways', tool: 'KEGG', what: 'Check which body processes your genes have in common.' },
  { name: 'Learn your genes', tool: 'GeneCards, OMIM, GO, UCSC', what: 'Look up what each gene does, where it is, and what diseases it’s linked to.' },
  { name: 'Write and present', tool: 'April conference', what: 'Write it up as an abstract and present it at the miRcore conference.', focal: true },
];

const eventCopy: Record<string, string> = {
  'Genes and Health Contest':
    'A free online contest about genetics and how to use the research tools. We practice for it in the meeting before.',
  'Brain Bee':
    'A neuroscience competition for high schoolers. Regional rounds are January to March, so we start practicing in December.',
  'Brain Awareness Week':
    'A week in March where we run quick brain science demos for the rest of Eastview.',
  'miRcore Research Conference':
    'The end of the GIDAS year. Members turn in an abstract and present their own project.',
};
---

<Base title="Research" description="How a NeuroGIDAS research project works, step by step, from picking a question to presenting in April. Plus the Brain Bee and other contests.">
  <header class="page-head">
    <div class="wrap">
      <h1 class="h1">How the research works</h1>
      <p class="lede">
        On GIDAS weeks you use the same free websites real scientists use. Each step takes a meeting or two, and each one builds
        on the one before it.
      </p>
    </div>
  </header>

  <section class="section path-sec" aria-labelledby="path-h">
    <div class="wrap">
      <h2 class="visually-hidden" id="path-h">The research path</h2>
      <figure class="pipe-fig">
        <ol class="pipe">
          {
            steps.map((s, i) => (
              <li class:list={['step', { 'step--focal': s.focal }]}>
                <span class="step__n tnum" aria-hidden="true">{i + 1}</span>
                <div class="step__body">
                  <span class="step__tool">{s.tool}</span>
                  <h3 class="step__name">{s.name}</h3>
                  <p class="step__what">{s.what}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <figcaption class="caption">
          <b>Fig. 4</b> The steps of a GIDAS project. Everyone picks their own dataset in December and takes it through every step
          by April.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="meet-h">
    <div class="wrap split">
      <h2 class="h2" id="meet-h">Brain cancer</h2>
      <div class="prose">
        <p>
          Cancer is this year’s research focus for every GIDAS chapter. That means both halves of the club can work on the same
          thing: brain cancer.
        </p>
        <p>
          In February we have a brain cancer night and start the <strong>Brain Cancer Innovation Challenge</strong>. Teams of three
          or four come up with an idea, check in halfway through, and present it at the end of May.
        </p>
      </div>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="events-h">
    <div class="wrap">
      <h2 class="h2" id="events-h">Contests and events</h2>
      <ol class="events">
        {
          EVENTS.map((e) => (
            <li class="event" data-track={e.track}>
              <p class="event__when">{e.when}</p>
              <div>
                <h3 class="h3">{e.name}</h3>
                <p class="muted">{eventCopy[e.name] ?? e.detail}</p>
              </div>
              <span class="tag" data-track={e.track}>{e.track === 'neuro' ? 'Neuroscience' : 'GIDAS research'}</span>
            </li>
          ))
        }
      </ol>
      <p class="caption events-note">
        The organizers set the exact dates. We post them in the GroupMe once they’re out. Learn more about GIDAS at{' '}
        <a href={LINKS.mircore} rel="noopener">mircore.org</a>.
      </p>
    </div>
  </section>

  <JoinBand />
</Base>

<style>
  .path-sec {
    padding-top: var(--s-8);
  }

  .pipe-fig {
    margin: 0;
  }

  .pipe {
    --rail: 2px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--s-4);
    position: relative;
  }

  /* The connector: one orthogonal rail through every step marker */
  .pipe::before {
    content: '';
    position: absolute;
    top: calc(1.25rem - var(--rail) / 2);
    left: 1.25rem;
    right: calc(100% / 7 - 1.25rem);
    height: var(--rail);
    background: var(--ink);
  }

  .step {
    position: relative;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .step__n {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink);
    font-weight: 750;
  }

  .step--focal .step__n {
    background: var(--teal-ink);
    border-color: var(--teal-ink);
    color: #fff;
  }

  .step__body {
    display: grid;
    gap: var(--s-2);
  }

  .step__tool {
    justify-self: start;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.2;
    padding: 0.25rem 0.45rem;
    border-radius: 2px;
    background: var(--teal-wash);
    color: var(--teal-ink);
  }

  .step--focal .step__tool {
    background: var(--teal-ink);
    color: #fff;
  }

  .step__name {
    font-size: var(--step-1);
    font-weight: 720;
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-variation-settings: 'wdth' 108;
  }

  .step__what {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
  }

  .pipe-fig .caption {
    margin-top: var(--s-7);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--s-6) clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  .events {
    list-style: none;
    margin-top: var(--s-7);
    border-top: 1px solid var(--ink);
  }

  .event {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr) auto;
    gap: var(--s-5);
    align-items: baseline;
    padding: var(--s-6) 0;
    border-bottom: 1px solid var(--rule);
  }

  .event__when {
    font-size: var(--step-1);
    line-height: 1.2;
    font-weight: 760;
    letter-spacing: -0.02em;
    font-variation-settings: 'wdth' 118;
  }

  .event .h3 {
    margin-bottom: var(--s-2);
  }

  .event .muted {
    max-width: 60ch;
  }

  .events-note {
    margin-top: var(--s-5);
  }

  @media (max-width: 1100px) {
    .pipe {
      grid-template-columns: 1fr;
      gap: 0;
      max-width: 40rem;
    }

    .pipe::before {
      display: none;
    }

    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      left: calc(1.25rem - var(--rail) / 2);
      top: 2.5rem;
      bottom: 0;
      width: var(--rail);
      background: var(--ink);
    }

    .step {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--s-5);
      padding-bottom: var(--s-6);
    }

    .step:last-child {
      padding-bottom: 0;
    }
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .event {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }

    .event .tag {
      order: -1;
    }
  }
</style>
