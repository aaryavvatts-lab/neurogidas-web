---
import Base from '../layouts/Base.astro';
import Emblem from '../components/Emblem.astro';
import NextMeeting from '../components/NextMeeting.astro';
import YearIdeogram from '../components/YearIdeogram.astro';
import JoinBand from '../components/JoinBand.astro';
import BrainToGene from '../components/BrainToGene.astro';
import { LINKS } from '../data/site';

const outcomes = [
  { t: 'A research question you picked', d: 'You choose what to study inside this year’s cancer focus.' },
  { t: 'Real data you looked at yourself', d: 'A public gene dataset, run through the same tools scientists use.' },
  { t: 'An abstract with your name on it', d: 'You write it, fix it up, and send it in for the April conference.' },
  { t: 'A presentation at a real conference', d: 'You present your project at the miRcore High School Research Conference.' },
];
---

<Base>
  <section class="stage" data-neural data-density="1.15">
  <div class="hero wrap">
    <div class="hero__copy">
      <h1 class="display">Learn how the brain works. Do real genetics research.</h1>
      <p class="lede">
        NeuroGIDAS is Eastview’s brain science and genetics club. We meet every Wednesday after school in B327, and you don’t
        need any experience to join.
      </p>
      <div class="hero__actions">
        <a class="btn btn-primary btn--icon" href={LINKS.groupme} rel="noopener">
          Join the GroupMe
          <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" /></svg></span>
        </a>
        <a class="btn btn-ghost" href="#next">See the next meeting</a>
      </div>
    </div>

    <figure class="hero__fig" data-fire>
      <div class="hero__halo" aria-hidden="true"></div>
      <Emblem variant="hero" class="hero__emblem" />
      <figcaption class="caption">
        <b>Fig. 1</b>
        Our logo. The neuron stands for neuroscience, and its axon turns into DNA, which stands for genetics research.
      </figcaption>
    </figure>
  </div>
  <p class="stage__hint" aria-hidden="true">Tap or move your mouse here to fire the neurons</p>
  </section>

  <div class="wrap next-wrap">
    <div class="bezel">
      <div class="bezel__core next-core">
        <NextMeeting />
      </div>
    </div>
  </div>

  <BrainToGene />

  <section class="section tracks" aria-labelledby="tracks-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h1" id="tracks-h">Two kinds of meetings</h2>
        <p class="lede">We switch every week. Come to both, or just the one you like.</p>
      </div>

      <div class="bento">
        <article class="panel panel--neuro">
          <div class="panel__text">
            <h3 class="h2">Neuroscience weeks</h3>
            <p class="panel__line">How the brain works, with labs you run on yourself.</p>
            <ul class="panel__list">
              <li>Labs on memory, attention, and reaction time</li>
              <li>Guest speakers who work in medicine</li>
              <li>Practice for the Brain Bee</li>
              <li>Reading real brain research together</li>
            </ul>
          </div>
          <Emblem variant="neuron" class="panel__fig" />
        </article>

        <article class="panel panel--gidas">
          <div class="panel__text">
            <h3 class="h2">GIDAS weeks</h3>
            <p class="panel__line">Genetics research with the same free tools scientists use.</p>
            <ul class="panel__list">
              <li>DNA, genes, and how they cause disease</li>
              <li>NCBI GEO, STRING, and KEGG</li>
              <li>One project you build all year</li>
              <li>A presentation at a conference in April</li>
            </ul>
          </div>
          <Emblem variant="helix" class="panel__fig panel__fig--helix" />
        </article>

        <a class="panel panel--meet" href="/about/">
          <p class="panel__meet-text">
            <span class="panel__meet-h">Where they meet: brain cancer.</span>
            Cancer is this year’s research focus, so in February both tracks work on brain cancer together.
          </p>
          <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" /></svg></span>
          <span class="visually-hidden">Read more about how the club works</span>
        </a>
      </div>
    </div>
  </section>

  <section class="lab" aria-labelledby="year-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h1" id="year-h">This year’s schedule</h2>
        <p class="lede">Each stripe is one Wednesday. Tap one to see what we’re doing that week.</p>
      </div>
      <YearIdeogram dark />
      <p class="lab__more">
        <a class="btn btn-light btn--icon" href="/meetings/">
          See the full schedule
          <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" /></svg></span>
        </a>
      </p>
    </div>
  </section>

  <section class="section outcomes" aria-labelledby="out-h">
    <div class="wrap">
      <h2 class="h1" id="out-h">What you’ll have by April</h2>
      <ol class="path">
        {
          outcomes.map((o, i) => (
            <li class="path__step">
              <span class="path__n tnum" aria-hidden="true">{i + 1}</span>
              <h3 class="h3">{o.t}</h3>
              <p class="muted">{o.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="book" aria-labelledby="book-h">
    <div class="wrap book__grid">
      <div class="book__copy">
        <h2 class="h1" id="book-h">From Neuron to Bedside</h2>
        <p class="lede">
          Aaryav wrote a free neuroscience textbook for high school students. It has 16 chapters with quizzes, 16 simulations you
          can play with, and a full Brain Bee practice test.
        </p>
        <a class="btn btn-ink btn--icon" href={LINKS.textbook} rel="noopener">
          Read the textbook
          <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" /></svg></span>
        </a>
      </div>
      <figure class="book__shot">
        <div class="bezel">
          <div class="bezel__core browser">
            <div class="browser__bar" aria-hidden="true">
              <i></i><i></i><i></i>
              <span class="browser__url">aaryavvatts-lab.github.io/neuroscience-textbook</span>
            </div>
            <img
              src="/media/textbook.webp"
              srcset="/media/textbook-800.webp 800w, /media/textbook.webp 1600w"
              sizes="(max-width: 900px) 92vw, 640px"
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
              alt="The home page of From Neuron to Bedside, showing the book's cover and its list of chapters."
            />
          </div>
        </div>
        <figcaption class="caption"><b>Fig. 3</b> The textbook’s home page. It works on a phone too.</figcaption>
      </figure>
    </div>
  </section>

  <JoinBand />
</Base>

<style>
  /* Dark stage: the live neural network runs behind the hero */
  .stage {
    --paper: var(--lab);
    --ink: #f4f3ee;
    --ink-2: #c3c7d1;
    --rule-strong: rgba(255, 255, 255, 0.28);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(70% 60% at 78% 30%, rgba(91, 75, 214, 0.22), transparent 70%),
      radial-gradient(60% 55% at 85% 95%, rgba(14, 143, 132, 0.2), transparent 70%),
      var(--lab);
    color: var(--ink);
    padding-bottom: clamp(6rem, 4rem + 6vw, 9rem);
  }

  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(21, 24, 31, 0.9) 0%, rgba(21, 24, 31, 0.55) 42%, rgba(21, 24, 31, 0) 75%);
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__hint {
      display: none;
    }
  }

  .stage__hint {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: clamp(5rem, 3.5rem + 4vw, 7.5rem);
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.5);
  }

  .hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7) clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    min-height: min(calc(100svh - 4.25rem - 4rem), 52rem);
    padding-top: clamp(2.5rem, 1rem + 5vw, 5rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 4rem);
  }

  .hero :focus-visible {
    outline-color: #fff;
  }

  .btn-ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.04);
  }

  .btn-ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .hero__copy .display {
    max-width: 13ch;
  }

  .hero__copy .lede {
    margin-top: var(--s-6);
    max-width: 40ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .hero__fig {
    position: relative;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    --halo: var(--lab);
  }

  .hero__halo {
    position: absolute;
    top: 8%;
    left: 50%;
    width: min(26rem, 90%);
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 110, 240, 0.28), rgba(38, 196, 182, 0.08) 55%, transparent 70%);
    pointer-events: none;
  }

  .hero__fig :global(.hero__emblem) {
    position: relative;
    width: auto;
    height: clamp(17rem, 11rem + 15vw, 27rem);
    color: #fff;
    filter: drop-shadow(0 0 24px rgba(124, 110, 240, 0.35));
  }

  .hero__fig :global(.hero__emblem path[stroke='var(--rule-strong)']) {
    stroke: rgba(255, 255, 255, 0.28);
  }

  .hero__fig .caption {
    position: relative;
    max-width: 30ch;
    text-align: center;
  }

  .next-wrap {
    position: relative;
    z-index: 3;
    margin-top: calc(-1 * clamp(4rem, 3rem + 3vw, 6rem));
    padding-bottom: var(--s-9);
  }

  .next-core {
    padding: var(--s-6) clamp(1.25rem, 0.5rem + 3vw, 3rem) clamp(1.75rem, 1rem + 2vw, 2.75rem);
  }

  .next-core :global(.next) {
    border-top: 0;
    padding-top: 0;
  }

  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-5) var(--s-6);
    align-items: end;
    margin-bottom: var(--s-7);
  }

  .sec-head .lede {
    justify-self: end;
    max-width: 34ch;
  }

  /* Tracks bento */
  .tracks {
    padding-top: var(--section);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    color: #fff;
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-5);
    box-shadow: var(--shadow-soft);
  }

  .panel--neuro {
    grid-column: span 7;
    background: var(--indigo);
    --halo: var(--indigo);
  }

  .panel--gidas {
    grid-column: span 5;
    background: var(--teal-ink);
    --halo: var(--teal-ink);
  }

  .panel__line {
    margin-top: var(--s-3);
    font-size: var(--step-1);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.86);
    max-width: 26ch;
  }

  .panel__list {
    list-style: none;
    margin-top: var(--s-6);
    max-width: 30rem;
  }

  .panel__list li {
    padding: 0.8rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.24);
  }

  .panel :global(.panel__fig) {
    color: #fff;
    width: auto;
    height: clamp(7rem, 5rem + 5vw, 10.5rem);
    opacity: 0.95;
  }

  .panel :global(.panel__fig--helix) {
    height: clamp(9rem, 6rem + 7vw, 13rem);
  }

  .panel--meet {
    grid-column: span 12;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    background: var(--ink);
    padding-block: var(--s-6);
    text-decoration: none;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .panel--meet .btn__icon {
    background: rgba(255, 255, 255, 0.12);
    width: 2.75rem;
    height: 2.75rem;
  }

  .panel__meet-text {
    font-size: var(--step-1);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.82);
    max-width: 62ch;
  }

  .panel__meet-h {
    color: #fff;
    font-weight: 720;
    margin-right: 0.3em;
  }

  @media (hover: hover) and (pointer: fine) {
    .panel--meet:hover {
      background: #2a2f3a;
    }

    .panel--meet:hover .btn__icon {
      transform: translate(2px, -2px);
    }
  }

  .panel--meet:focus-visible {
    outline: 3px solid var(--indigo);
    outline-offset: 3px;
  }

  /* Dark lab band for the year */
  .lab {
    background: var(--lab);
    color: #f2f1ec;
    padding-block: var(--section);
  }

  .lab .lede {
    color: #b7bcc8;
  }

  .lab__more {
    margin-top: var(--s-7);
  }

  .lab :focus-visible {
    outline-color: #fff;
  }

  /* Outcomes */
  .path {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-8);
    position: relative;
  }

  .path::before {
    content: '';
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--neuro), var(--gidas));
  }

  .path__step {
    position: relative;
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .path__n {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink);
    font-weight: 750;
    margin-bottom: var(--s-3);
  }

  .path__step:last-child .path__n {
    background: var(--ink);
    color: var(--paper);
  }

  /* Textbook */
  .book {
    background: var(--indigo-wash);
    padding-block: var(--section);
  }

  .book__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 5vw, 5.5rem);
    align-items: center;
  }

  .book__copy .lede {
    margin-top: var(--s-5);
    margin-bottom: var(--s-6);
    max-width: 36ch;
  }

  .book__shot {
    margin: 0;
    display: grid;
    gap: var(--s-4);
  }

  .book__shot .caption {
    padding-inline: var(--s-3);
  }

  @media (max-width: 960px) {
    .panel--neuro,
    .panel--gidas {
      grid-column: span 12;
    }
  }

  @media (max-width: 900px) {
    .hero,
    .book__grid,
    .sec-head {
      grid-template-columns: 1fr;
    }

    .sec-head .lede {
      justify-self: start;
    }

    .path {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--s-7);
    }

    .path::before {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .panel {
      grid-template-columns: 1fr;
    }

    .panel :global(.panel__fig) {
      grid-row: 1;
      height: 6rem;
    }

    .panel :global(.panel__fig--helix) {
      height: 7.5rem;
    }

    .panel--meet {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .path {
      grid-template-columns: 1fr;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__fig :global(.hero__emblem) {
      height: 15rem;
    }
  }
</style>

<script>
  // Fire the signal once on load, and again when a mouse moves onto the figure.
  const fig = document.querySelector<HTMLElement>('[data-fire]');
  if (fig) {
    const fire = () => {
      fig.classList.remove('is-firing');
      void fig.offsetWidth;
      fig.classList.add('is-firing');
    };
    setTimeout(fire, 450);
    let last = 0;
    fig.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (Date.now() - last > 2600) {
        last = Date.now();
        fire();
      }
    });
  }
</script>
