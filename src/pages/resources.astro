---
import Base from '../layouts/Base.astro';
import JoinBand from '../components/JoinBand.astro';
import HeadFigure from '../components/HeadFigure.astro';
import { LINKS } from '../data/site';

const tb = LINKS.textbook;
const bookLinks = [
  { href: tb, t: 'Start reading', d: 'All 16 chapters, each with a quiz.' },
  { href: `${tb}sims/`, t: 'Simulations', d: '16 interactive models you can play with, like firing a neuron.' },
  { href: `${tb}appendices/brain-bee/`, t: 'Brain Bee guide', d: 'Tips for the competition and a full practice test.' },
  { href: `${tb}club-kit/`, t: 'Club and study group kit', d: 'How to use the book with a club or a study group.' },
];

const tools = [
  { name: 'NCBI GEO', href: 'https://www.ncbi.nlm.nih.gov/geo/', d: 'A free library of gene studies. This is where your dataset comes from.' },
  { name: 'GEO2R', href: 'https://www.ncbi.nlm.nih.gov/geo/geo2r/', d: 'Compares samples in a study to find the genes that change.' },
  { name: 'STRING', href: 'https://string-db.org/', d: 'Shows how proteins connect, as a map you can click around.' },
  { name: 'KEGG Pathway', href: 'https://www.genome.jp/kegg/pathway.html', d: 'Maps of body processes, so you can see what your genes do together.' },
  { name: 'GeneCards', href: 'https://www.genecards.org/', d: 'A summary page for almost every human gene.' },
  { name: 'OMIM', href: 'https://www.omim.org/', d: 'A list of human genes and the diseases linked to them.' },
  { name: 'Gene Ontology', href: 'https://geneontology.org/', d: 'Standard labels for what each gene does and where.' },
  { name: 'UCSC Genome Browser', href: 'https://genome.ucsc.edu/', d: 'Lets you see where any gene sits in our DNA.' },
];

const neuro = [
  { name: 'The Brain Facts book', href: 'https://www.brainfacts.org/the-brain-facts-book', d: 'The main study book for the Brain Bee. Free to read online.' },
  { name: 'BrainFacts.org', href: 'https://www.brainfacts.org/', d: 'Short, trustworthy articles about the brain.' },
  { name: 'The Brain Bee', href: 'https://www.thebrainbee.org/', d: 'The official competition site, with the rules and how regionals work.' },
  { name: 'miRcore GIDAS', href: LINKS.gidas, d: 'The program behind our research side.' },
];
---

<Base title="Resources" description="Free resources NeuroGIDAS uses: the From Neuron to Bedside neuroscience textbook, the GIDAS research databases, and Brain Bee study material.">
  <header class="page-head">
    <div class="wrap head-grid">
      <div>
      <h1 class="h1">Resources</h1>
      <p class="lede">Everything we use is free. You can use all of it at home too.</p>
    </div>
      <HeadFigure kind="shelf" n={7} />
    </div>
  </header>

  <section class="book" aria-labelledby="book-h">
    <div class="wrap book__grid">
      <div>
        <h2 class="h1" id="book-h">From Neuron to Bedside</h2>
        <p class="lede">
          A free neuroscience textbook for high school students, written by our co-president Aaryav Sharma. It goes deeper on the
          topics we cover in neuroscience weeks.
        </p>
        <a class="btn btn-ink btn--icon book__cta" href={tb} rel="noopener">
          Read the textbook
          <span class="btn__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" /></svg></span>
        </a>
        <div class="bezel book__shot">
          <div class="bezel__core browser">
            <div class="browser__bar" aria-hidden="true">
              <i></i><i></i><i></i>
              <span class="browser__url">aaryavvatts-lab.github.io/neuroscience-textbook</span>
            </div>
            <img
              src="/media/textbook-800.webp"
              srcset="/media/textbook-800.webp 800w, /media/textbook.webp 1600w"
              sizes="(max-width: 860px) 92vw, 460px"
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
              alt="The home page of From Neuron to Bedside."
            />
          </div>
        </div>
      </div>
      <ul class="book__links">
        {
          bookLinks.map((l) => (
            <li>
              <a href={l.href} rel="noopener">
                <span class="bl__t">{l.t}</span>
                <span class="bl__d">{l.d}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2" id="tools-h">Research tools</h2>
        <p class="muted">The websites we use in GIDAS weeks, in the order you’ll use them.</p>
      </div>
      <ul class="res res--gidas">
        {
          tools.map((t) => (
            <li>
              <a href={t.href} rel="noopener">
                <span class="res__name">{t.name}</span>
                <span class="res__d">{t.d}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="neuro-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2" id="neuro-h">Brain Bee and more reading</h2>
        <p class="muted">For neuroscience weeks and Brain Bee practice.</p>
      </div>
      <ul class="res res--neuro">
        {
          neuro.map((t) => (
            <li>
              <a href={t.href} rel="noopener">
                <span class="res__name">{t.name}</span>
                <span class="res__d">{t.d}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <JoinBand />
</Base>

<style>
  .book {
    background: var(--indigo-wash);
    padding-block: var(--section);
  }

  .book__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  .book .lede {
    margin-top: var(--s-5);
    max-width: 40ch;
  }

  .book__cta {
    margin-top: var(--s-6);
  }

  .book__shot {
    margin-top: var(--s-7);
    max-width: 30rem;
  }

  .book__links {
    list-style: none;
    border-top: 2px solid var(--indigo);
  }

  .book__links li {
    border-bottom: 1px solid color-mix(in srgb, var(--indigo) 22%, transparent);
  }

  .book__links a,
  .res a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.2rem var(--s-4);
    padding: 1.1rem 0;
    text-decoration: none;
  }

  .bl__t,
  .res__name {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    font-variation-settings: 'wdth' 108;
  }

  .bl__d,
  .res__d {
    grid-row: 2;
    color: var(--ink-2);
  }

  .book__links svg,
  .res svg {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .book__links a:hover svg,
    .res a:hover svg {
      transform: translate(3px, -3px);
    }
  }

  .book__links a:hover .bl__t,
  .res a:hover .res__name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .sec-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3) var(--s-6);
  }

  .res {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2rem, 1rem + 4vw, 5rem);
    margin-top: var(--s-7);
  }

  .res li {
    border-top: 1px solid var(--rule-strong);
  }

  .res--gidas li:nth-child(-n + 2) {
    border-top: 2px solid var(--gidas);
  }

  .res--neuro li:nth-child(-n + 2) {
    border-top: 2px solid var(--neuro);
  }

  @media (max-width: 860px) {
    .book__grid,
    .res {
      grid-template-columns: 1fr;
    }

    .res--gidas li:nth-child(2),
    .res--neuro li:nth-child(2) {
      border-top: 1px solid var(--rule-strong);
    }
  }
</style>
