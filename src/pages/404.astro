---
import Base from '../layouts/Base.astro';
import Emblem from '../components/Emblem.astro';
---

<Base title="Page not found" description="This page does not exist on the NeuroGIDAS site.">
  <section class="nf wrap">
    <div class="nf__grid">
    <div>
    <p class="nf__code tnum" aria-hidden="true">404</p>
    <h1 class="h1">This page does not exist.</h1>
    <p class="lede">The link may be old or mistyped. Try one of these instead.</p>
    <div class="nf__actions">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn btn-quiet" href="/meetings/">See the next meeting</a>
    </div>
    </div>
    <figure class="nf__fig">
      <div class="cut" aria-hidden="true">
        <Emblem variant="hero" class="cut__emblem" />
        <svg class="cut__gap" viewBox="20 8 200 428" fill="none" stroke-linecap="round">
          <rect x="104" y="150" width="32" height="30" fill="var(--paper)" />
          <path d="M113 150 L127 144 M113 180 L127 174" stroke="var(--salmon)" stroke-width="3" />
        </svg>
      </div>
      <figcaption class="caption"><b>Fig. 0</b> A signal with nowhere to go. The axon is cut, so it never reaches the helix.</figcaption>
    </figure>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(4rem, 2rem + 8vw, 9rem);
  }

  .nf__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--s-7);
    align-items: center;
  }

  .nf__fig {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
  }

  .cut {
    display: grid;
  }

  .cut > :global(*) {
    grid-area: 1 / 1;
    height: clamp(14rem, 10rem + 10vw, 22rem);
    width: auto;
  }

  .nf__fig .caption {
    max-width: 28ch;
  }

  @media (max-width: 760px) {
    .nf__grid {
      grid-template-columns: 1fr;
    }

    .nf__fig {
      justify-items: start;
    }

    .cut > :global(*) {
      height: 11rem;
    }
  }

  .nf__code {
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-variation-settings: 'wdth' 125;
    color: #8a8f99;
    margin-bottom: var(--s-5);
  }

  .nf .lede {
    margin-top: var(--s-4);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
</style>
